# Copiar a .env para cambiar la configuración local de docker compose. El archivo .env no se versiona.
POSTGRES_DB=sistema
POSTGRES_USER=sistema
POSTGRES_PASSWORD=sistema

# Puertos publicados en la máquina (cambiarlos si ya están en uso).
DB_PORT=5432
API_PORT=8000
WEB_PORT=4200

# Contraseña de las cuentas iniciales: CLAVE_INICIAL=... python -m app.modulos.seguridad.semilla
#CLAVE_INICIAL=

# Seguridad (HU-1.09): minutos de inactividad que cierran la sesión, intentos fallidos que bloquean
# la cuenta y minutos que dura el bloqueo.
#SESION_MINUTOS=480
#INTENTOS_MAXIMOS=5
#BLOQUEO_MINUTOS=15
