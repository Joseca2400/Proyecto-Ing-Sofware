# Copiar a .env y ajustar. El archivo .env no se versiona.
PORT=3000

# PostgreSQL. Crear antes la base:  createdb kilometro_cero
DATABASE_URL=postgres://postgres@localhost:5432/kilometro_cero

# Contraseña inicial de las cuentas sembradas (solo ambiente de pruebas).
PASSWORD_INICIAL=Demo2026!

# Duración de la sesión, en horas.
HORAS_SESION=8
